{
 "charter": "lib/drawing/CHARTER.md",
 "version": "1.0",
 "date": "2026-10-28",
 "source": "机械零件 SVG 制图经验与自检规程（2026-10-28）",
 "status_legend": {
  "A": "有自动检查",
  "M": "人工签字",
  "X": "已规定、当前无实现"
 },
 "severity_legend": {
  "必": "不通过不得交付",
  "应": "偏离需在自检记录中说明"
 },
 "rules": [
  {
   "id": "GEN-01",
   "ch": "1",
   "sev": "必",
   "st": "X",
   "req": "用程序化矢量绘图生成正式工程图，不用图像生成模型绘制需要精确尺寸、公差与文字的图"
  },
  {
   "id": "GEN-02",
   "ch": "1",
   "sev": "必",
   "st": "M",
   "req": "先核对输入结构，再确定表达方案；不先摆版式后补结构"
  },
  {
   "id": "GEN-03",
   "ch": "1",
   "sev": "必",
   "st": "X",
   "req": "所有视图、断面、尺寸与技术要求在生成时引用同一份最终参数"
  },
  {
   "id": "GEN-04",
   "ch": "1",
   "sev": "必",
   "st": "A",
   "req": "几何投影、特征关联标注、纸面排版三层分开管理，不互相顶替"
  },
  {
   "id": "GEN-05",
   "ch": "1",
   "sev": "必",
   "st": "A",
   "req": "使用工作库前核对当前签名、实现与输出，不把函数名当作标准符合性证明"
  },
  {
   "id": "GEN-06",
   "ch": "1",
   "sev": "必",
   "st": "A",
   "req": "分开检查“该线应否存在”（画法）与“线是否在预定位置”（实现），两者都要通过"
  },
  {
   "id": "GEN-07",
   "ch": "1",
   "sev": "必",
   "st": "X",
   "req": "每次修改后重新生成并检查当前版本，不用旧截图判断新图"
  },
  {
   "id": "GEN-08",
   "ch": "1",
   "sev": "必",
   "st": "X",
   "req": "不以缩小文字、遮盖轮廓或删除必需视图来消除布局冲突"
  },
  {
   "id": "GEN-09",
   "ch": "1",
   "sev": "必",
   "st": "M",
   "req": "输入几何不成立时记录具体冲突；需改设计的先按授权同步源数据，不在图上偷改数值"
  },
  {
   "id": "GEN-10",
   "ch": "1",
   "sev": "必",
   "st": "A",
   "req": "未执行或未覆盖的检查写“未检查”，不把空错误列表解释为全部合格"
  },
  {
   "id": "IN-01",
   "ch": "2",
   "sev": "必",
   "st": "X",
   "req": "出图前建立输入清单：零件身份、实体结构、空间关系、尺寸含义、精度要求、其他要求、图纸要求、依据"
  },
  {
   "id": "IN-02",
   "ch": "2",
   "sev": "必",
   "st": "X",
   "req": "关键输入缺失时不猜测补齐；只缺署名、单位等非几何字段可留空"
  },
  {
   "id": "IN-03",
   "ch": "2",
   "sev": "必",
   "st": "M",
   "req": "不把“通常有中心孔”“一般用这种配合”转化为实体特征，也不把相邻零件特征画到本零件上"
  },
  {
   "id": "IN-04",
   "ch": "2",
   "sev": "必",
   "st": "X",
   "req": "参考图只迁移适用的表达方法与版式，不携带参考零件的参数"
  },
  {
   "id": "IN-05",
   "ch": "2",
   "sev": "应",
   "st": "X",
   "req": "每项关键输入记录来源与状态：已确认 / 待确认 / 推导值"
  },
  {
   "id": "STD-01",
   "ch": "3",
   "sev": "必",
   "st": "M",
   "req": "按任务要求的的标准体系核对图幅、比例、字体、图线、视图、尺寸、几何公差、表面结构与标题栏"
  },
  {
   "id": "STD-02",
   "ch": "3",
   "sev": "应",
   "st": "X",
   "req": "依据为教材时记录书名、图表号与印刷页；PDF 物理页映射单独登记，不跨书套用页码偏移"
  },
  {
   "id": "STD-03",
   "ch": "3",
   "sev": "应",
   "st": "M",
   "req": "易误判的表达先看同类结构原图局部，列出可见边、不可见边、剖切边与省略规则再画"
  },
  {
   "id": "STD-04",
   "ch": "3",
   "sev": "必",
   "st": "X",
   "req": "区分三类内容：标准表达规则、绘图实现约定、某次图样的选择"
  },
  {
   "id": "STD-05",
   "ch": "3",
   "sev": "必",
   "st": "M",
   "req": "不把历史工作库说明或某渲染器的缺陷推广成“所有图都只能这样画”"
  },
  {
   "id": "MDL-01",
   "ch": "4.1",
   "sev": "必",
   "st": "X",
   "req": "数据分六层：part、geometry、precision、views、layout、checks"
  },
  {
   "id": "MDL-02",
   "ch": "4.1",
   "sev": "必",
   "st": "A",
   "req": "每个实体特征有稳定 feature_id"
  },
  {
   "id": "MDL-03",
   "ch": "4.1",
   "sev": "必",
   "st": "X",
   "req": "每个尺寸记录被测要素、测量方向、数值来源与控制/参考属性"
  },
  {
   "id": "MDL-04",
   "ch": "4.1",
   "sev": "必",
   "st": "X",
   "req": "同一结构只有一份参数，主视、端视、断面与尺寸文字均由它生成，不另存数值副本"
  },
  {
   "id": "MDL-05",
   "ch": "4.1",
   "sev": "必",
   "st": "X",
   "req": "模型坐标、图纸坐标、渲染坐标分开管理，明确原点与轴向"
  },
  {
   "id": "MDL-06",
   "ch": "4.1",
   "sev": "必",
   "st": "X",
   "req": "y 轴翻转只在输出层做一次，不在几何层与核查层重复翻转"
  },
  {
   "id": "MDL-07",
   "ch": "4.1",
   "sev": "必",
   "st": "X",
   "req": "纸面字高、箭头大小、线宽与标注间距独立管理，不随零件整体缩放"
  },
  {
   "id": "MDL-08",
   "ch": "4.1",
   "sev": "必",
   "st": "M",
   "req": "功能分区不是实体台阶：同一公称直径上的精度差异用范围表示、区段字母或局部要求表表达"
  },
  {
   "id": "VIEW-01",
   "ch": "5",
   "sev": "必",
   "st": "M",
   "req": "每个视图先登记名称、类型、观察方向、需表达特征、比例及与其他视图的对应关系"
  },
  {
   "id": "VIEW-02",
   "ch": "5",
   "sev": "应",
   "st": "M",
   "req": "视图数量以清晰完整表达结构为准，不为凑“三视图”增加重复视图，也不省略必要局部结构"
  },
  {
   "id": "VIEW-03",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "区分剖视图与断面图，不把所有含剖面线的图统称“剖面”"
  },
  {
   "id": "VIEW-04",
   "ch": "5",
   "sev": "必",
   "st": "M",
   "req": "断面特殊情形（剖切平面过回转面孔或凹坑轴线、非圆孔使断面分离）按规定保留应有线条"
  },
  {
   "id": "VIEW-05",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "投影法统一，基本视图满足长对正、高平齐、宽相等；第一角俯视图在下、右视图在左"
  },
  {
   "id": "VIEW-06",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "投影法识别符号按标准图例绘制，第一角为圆台侧形在左、同心圆在右、侧形左小右大"
  },
  {
   "id": "VIEW-07",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "槽口朝向由真实特征方向与剖切观察方向推导，不由版面空白决定"
  },
  {
   "id": "VIEW-08",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "剖切位置线、箭头、字母与断面/剖视图名称一一对应；箭头方向不得为让位而反转"
  },
  {
   "id": "VIEW-09",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "剖切平面实际穿过要表达的特征；断面直径、槽宽、槽深取自该位置实体"
  },
  {
   "id": "VIEW-10",
   "ch": "5",
   "sev": "必",
   "st": "M",
   "req": "主视投影为与轴线对中的长圆，仅适用于正对封闭圆头槽的情形"
  },
  {
   "id": "VIEW-11",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "断面缺口处不得残留穿过槽口的完整外圆，也不得填剖面线"
  },
  {
   "id": "VIEW-12",
   "ch": "5",
   "sev": "必",
   "st": "M",
   "req": "台阶竖线是否通长先判断可见性与视图类型，不统一画成通长或两小段"
  },
  {
   "id": "VIEW-13",
   "ch": "5",
   "sev": "必",
   "st": "M",
   "req": "轴、键、紧固件、肋、轮辐、螺纹、齿轮、花键、轴承按规定画法逐项核对条件"
  },
  {
   "id": "VIEW-14",
   "ch": "5",
   "sev": "必",
   "st": "X",
   "req": "同一零件的剖面线方向与间距一致，线族不穿越孔槽，必要时选标准允许的其他角度"
  },
  {
   "id": "GEO-01",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "圆角为与相邻表面相切的圆弧，保存切点、圆心与半径"
  },
  {
   "id": "GEO-02",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "圆角构造后核对端点连接与切线连续，不用折线拐弯或遮盖矩形伪装"
  },
  {
   "id": "GEO-03",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "倒角处原端面与母线在倒角端点截短后再连斜线，不在尖角上叠两条斜线"
  },
  {
   "id": "GEO-04",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "开放圆弧不用会自动闭合的多边形图元，否则出现连接两端的额外弦线"
  },
  {
   "id": "GEO-05",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "圆弧扫角核对起点、终点、圆心、切线与极值位置，不只确认半径"
  },
  {
   "id": "GEO-06",
   "ch": "6",
   "sev": "应",
   "st": "X",
   "req": "完整圆优先用圆图元，不用起终点重合的单段圆弧表达"
  },
  {
   "id": "GEO-07",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "直角轴肩四分之一圆内圆角满足 R_max ≤ h_min，h_min 按大径最小与小径最大计算"
  },
  {
   "id": "GEO-08",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "同一短段两端均有过渡时，两侧实际切线占用之和不超过可用长度"
  },
  {
   "id": "GEO-09",
   "ch": "6",
   "sev": "必",
   "st": "X",
   "req": "槽端、孔边、退刀槽与肩圆角的最小净距按最不利公差组合检查"
  },
  {
   "id": "SHT-01",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "按完整图面包络选择幅面：先预留图框、标题栏、技术要求、参数表、尺寸带与视图间距"
  },
  {
   "id": "SHT-02",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "图框边距随幅面与装订形式取自同一套规则，不混用不同幅面的边距"
  },
  {
   "id": "SHT-03",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "不把简化标题栏冒称为完整标准式标题栏"
  },
  {
   "id": "SHT-04",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "比例取自适用标准比例系列，并在标题栏及需要处标明"
  },
  {
   "id": "SHT-05",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "不得非等比拉伸图形；尺寸数字始终表示真实尺寸而非纸上测量值"
  },
  {
   "id": "SHT-06",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "线型按语义分配：可见轮廓与移出断面轮廓粗实线、尺寸与剖面细实线、轴线细点画线、必要时细虚线"
  },
  {
   "id": "SHT-07",
   "ch": "7",
   "sev": "应",
   "st": "X",
   "req": "粗细分档采用一致组合（通常约 2:1），具体按所选标准与图幅确定"
  },
  {
   "id": "SHT-08",
   "ch": "7",
   "sev": "应",
   "st": "X",
   "req": "中心线适当伸出轮廓，圆心位置以长画相交；短范围点画线核对实际节距"
  },
  {
   "id": "SHT-09",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "线型重合按标准优先次序表达，不把不同线型无条件叠加"
  },
  {
   "id": "SHT-10",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "汉字用仿宋体且不低于允许字高；上下偏差可用较小字号，但不得用于整段技术要求"
  },
  {
   "id": "SHT-11",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "font-size 不等于字形墨迹高度，核对所用字体的字面、字宽与实际打印效果"
  },
  {
   "id": "SHT-12",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "空间不足时加宽单元格、换行或重排，不让自动缩字把文字降到下限以下"
  },
  {
   "id": "SHT-13",
   "ch": "7",
   "sev": "必",
   "st": "X",
   "req": "标题栏空白字段可保留，不编造署名、审核记录或单位名称"
  },
  {
   "id": "DIM-01",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "每个尺寸核对五要素：测量起止要素、尺寸界线、尺寸线、终端符号、尺寸文字"
  },
  {
   "id": "DIM-02",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "模型尺寸链自洽，但总长与全部分段不同时作为互相重复的独立约束"
  },
  {
   "id": "DIM-03",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "尺寸界线从真实被测要素或其允许延长处引出，不从任意轴线或空白点起算"
  },
  {
   "id": "DIM-04",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "尺寸界线按规则越过尺寸线，延长方向由“远离被测要素”求得，上下侧符号不写反"
  },
  {
   "id": "DIM-05",
   "ch": "8",
   "sev": "应",
   "st": "X",
   "req": "尺寸线、箭头与文字按同一种标注方法统一布置，竖向数字的阅读方向与位置一致"
  },
  {
   "id": "DIM-06",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "直径、半径、槽宽、余厚与深度各有正确标识、终点与引注方式；漂浮文字不能冒充直径标注"
  },
  {
   "id": "DIM-07",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "狭窄处用标准允许的外置箭头、引出文字或延长段，文字外置后仍能辨认所属尺寸"
  },
  {
   "id": "DIM-08",
   "ch": "8",
   "sev": "应",
   "st": "X",
   "req": "尺寸线避免与轮廓、中心线重合；必要交叉按标准处理"
  },
  {
   "id": "DIM-09",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "文字与公差数字不被轮廓线、中心线、引线或箭头穿过"
  },
  {
   "id": "DIM-10",
   "ch": "8",
   "sev": "应",
   "st": "X",
   "req": "尺寸集中在表达该结构最清楚的视图，不在多视图重复给同一独立控制尺寸"
  },
  {
   "id": "DIM-11",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "尺寸公差、配合、几何公差与表面结构分别管理；键槽与轴、槽深与余厚不是同一受控对象"
  },
  {
   "id": "DIM-12",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "槽深改注余厚时偏差符号反转；有独立直径偏差时按 q_min=d_min−t_max、q_max=d_max−t_min 推导"
  },
  {
   "id": "DIM-13",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "上下偏差叠排、位置明确，不用斜杠写成含糊文字串；宽度计算含整个组合"
  },
  {
   "id": "DIM-14",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "一般尺寸公差不自动代替几何公差；已单独给定的公差不被总注覆盖；圆角倒角的未注公差单独核对"
  },
  {
   "id": "DIM-15",
   "ch": "8",
   "sev": "必",
   "st": "X",
   "req": "基准符号连接位置表达设计所指要素；圆柱面导出轴线基准与直径尺寸线对齐，不用随便指向外圆的引线冒充"
  },
  {
   "id": "DIM-16",
   "ch": "8",
