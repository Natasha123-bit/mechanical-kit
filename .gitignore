*.pyc

# macOS
.DS_Store

# 渲染产物：draw/<章>/build.sh 分钟级重建（实测单章约 3 分钟）
draw/**/*.png
draw/**/*.svg
draw/**/*.pdf
draw/**/*.html
draw/**/*.log

